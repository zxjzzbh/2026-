[Unit]
Description=Smart car 5G dashboard with explicit startup preparation
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smartcar-race-20261002
Environment=PYTHONPATH=/home/pi/smartcar-race-20261002/vision/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/smartcar-race-20261002/.venv/bin/python /home/pi/smartcar-race-20261002/vision/tools/serve_boot_test.py --root /home/pi/smartcar-race-20261002
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
